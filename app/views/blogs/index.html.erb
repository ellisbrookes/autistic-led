<% content_for :title, "Blog" %>

<section class="mx-auto w-full max-w-3xl px-4 pt-14">
  <% if notice.present? %>
    <p id="notice" class="mb-6 border-l-4 border-green-500 pl-3 font-medium text-green-700 dark:text-green-300"><%= notice %></p>
  <% end %>

  <p class="inline-block border-b-2 pb-1.5 text-[length:calc(13px*var(--a11y-scale))] font-bold uppercase tracking-[0.14em] text-[var(--a11y-accent)] [border-color:var(--a11y-accent)]">Blog</p>
  <h1 class="mt-4 max-w-2xl text-balance font-extrabold text-[var(--a11y-text)] [line-height:1.1] text-[length:clamp(30px,4.2vw,calc(44px*var(--a11y-scale)))]">Stories from the community</h1>
  <p class="mt-3 max-w-2xl text-[var(--a11y-muted)] text-[length:calc(17px*var(--a11y-scale))] [line-height:1.6]">Reflections, updates and things we have learned — written by the people who make up Autistic Led.</p>

  <% if authenticated? %>
    <%= link_to "Write a new post", new_blog_path,
          class: "mt-5 inline-flex items-center gap-1.5 border-b-2 pb-[3px] font-bold text-[var(--a11y-text)] text-[length:calc(15px*var(--a11y-scale))] [border-color:var(--a11y-accent)]" %>
  <% end %>
</section>

<section class="mx-auto w-full max-w-3xl px-4 pb-20 pt-6">
  <% if @blogs.any? %>
    <% @blogs.each_with_index do |blog, index| %>
      <% word_count = blog.content.to_plain_text.split.size %>
      <% reading_time = [1, (word_count / 220.0).ceil].max %>

      <article class="<%= index.zero? ? "pt-2" : "mt-8 border-t pt-8 [border-color:var(--a11y-border)]" %>">
        <p class="text-[length:calc(13px*var(--a11y-scale))] font-semibold uppercase tracking-[0.06em] text-[var(--a11y-muted)]">
          <time datetime="<%= blog.created_at.iso8601 %>"><%= blog.created_at.strftime("%d %B %Y") %></time>
          &middot; <%= pluralize(reading_time, "minute") %> read
          <% unless blog.approved? %>
            &middot; <span class="text-amber-600 dark:text-amber-400">Pending approval</span>
          <% end %>
        </p>

        <h2 class="mt-2.5">
          <%= link_to blog_path(blog),
                class: "font-extrabold text-[var(--a11y-text)] text-[length:calc(22px*var(--a11y-scale))] [line-height:1.3]" do %>
            <%= blog.title %>
          <% end %>
        </h2>

        <p class="mt-2 text-[var(--a11y-muted)] text-[length:calc(16px*var(--a11y-scale))] [line-height:1.6]">
          <%= blog_preview_text(blog).presence || "No preview available yet." %>
        </p>

        <div class="mt-3 flex flex-wrap items-center gap-5">
          <%= link_to "Read more →", blog_path(blog),
                class: "font-bold text-[var(--a11y-accent)] text-[length:calc(14px*var(--a11y-scale))]" %>

          <% if owns_blog?(blog) || admin? %>
            <% if owns_blog?(blog) %>
              <%= link_to "Edit", edit_blog_path(blog),
                    class: "font-semibold text-[var(--a11y-link)] text-[length:calc(14px*var(--a11y-scale))] underline-offset-[3px] [text-decoration:var(--a11y-underline)]" %>
            <% end %>
            <%= button_to "Destroy", blog_path(blog), method: :delete,
                  class: "bg-transparent p-0 font-semibold text-red-600 text-[length:calc(14px*var(--a11y-scale))] underline dark:text-red-400",
                  form_class: "inline-flex",
                  data: { turbo_confirm: "Are you sure?" } %>
            <% if admin? && !blog.approved? %>
              <%= button_to "Approve", approve_blog_path(blog), method: :patch,
                    class: "bg-transparent p-0 font-semibold text-[var(--a11y-link)] text-[length:calc(14px*var(--a11y-scale))] underline-offset-[3px] [text-decoration:var(--a11y-underline)]",
                    form_class: "inline-flex" %>
            <% end %>
          <% end %>
        </div>
      </article>
    <% end %>
  <% else %>
    <p class="py-10 text-center text-[var(--a11y-muted)] text-[length:calc(16px*var(--a11y-scale))]">No blogs found.</p>
  <% end %>
</section>
