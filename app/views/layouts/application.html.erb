<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? "Autistic Led - #{content_for(:title)}" : "Autistic Led" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Autistic Led">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-[var(--a11y-bg)] text-[var(--a11y-text)] [font-family:var(--a11y-font)] [line-height:var(--a11y-line-height)] [letter-spacing:var(--a11y-letter-spacing)] transition-colors [transition-duration:var(--a11y-motion-duration)]"
        data-controller="accessibility">

    <a href="#main"
       class="absolute left-3 -top-16 z-[100] rounded-lg bg-[var(--a11y-accent)] px-4 py-2.5 text-sm font-bold text-[var(--a11y-accent-text)] transition-[top] duration-150 focus:outline-none focus-visible:top-3">Skip to main content</a>
    <div data-accessibility-target="liveRegion" aria-live="polite" class="sr-only"></div>

    <!-- Navigation-->
    <%= render Website::NavigationComponent.new %>

    <!-- Page content -->
    <main id="main" class="flex flex-1 flex-col">
      <%= yield %>
    </main>

    <!-- Footer -->
    <%= render Website::FooterComponent.new %>
  </body>
</html>
