<footer class="border-t bg-[var(--a11y-bg)] [border-color:var(--a11y-border)]">

  <div class="mx-auto max-w-6xl px-4">

    <!-- Brand / Links / Accessibility -->
    <div class="grid gap-10 pt-10 sm:grid-cols-[1.3fr_1fr_1fr]">

      <div>
        <p class="text-2xl font-extrabold text-[var(--a11y-text)]">Autistic Led</p>
        <p class="mt-3 max-w-sm font-medium text-[var(--a11y-muted)] text-[length:calc(17px*var(--a11y-scale))] [line-height:1.5]">The journey may vary, but it is always Autistic Led.</p>

        <a href="https://www.facebook.com/AutisticLedSouthHolland"
           target="_blank"
           rel="noopener noreferrer"
           class="mt-4 inline-flex text-[var(--a11y-muted)]"
           aria-label="Autistic Led on Facebook">
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
      </div>

      <div>
        <p class="text-[length:calc(13px*var(--a11y-scale))] font-bold uppercase tracking-[0.1em] text-[var(--a11y-muted)]">Links</p>
        <ul class="mt-4 flex flex-col gap-3">
          <li>
            <%= link_to "About", root_path(anchor: "about"),
                  class: "font-semibold text-[var(--a11y-link)] text-[length:calc(17px*var(--a11y-scale))] underline-offset-[3px] [text-decoration:var(--a11y-underline)]" %>
          </li>
          <li>
            <%= link_to "Contact", root_path(anchor: "contact"),
                  class: "font-semibold text-[var(--a11y-link)] text-[length:calc(17px*var(--a11y-scale))] underline-offset-[3px] [text-decoration:var(--a11y-underline)]" %>
          </li>
        </ul>
      </div>

      <div>
        <p class="text-[length:calc(13px*var(--a11y-scale))] font-bold uppercase tracking-[0.1em] text-[var(--a11y-muted)]">Accessibility</p>
        <button type="button"
                class="mt-4 flex items-center gap-2 bg-transparent p-0 font-bold text-[var(--a11y-link)] text-[length:calc(17px*var(--a11y-scale))]"
                data-accessibility-target="toggleButton"
                data-action="click->accessibility#togglePanel"
                aria-expanded="false"
                aria-controls="a11y-panel">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 15.5v.01"/>
          </svg>
          Accessibility settings
        </button>
      </div>

    </div>

    <!-- Accessibility settings panel -->
    <div id="a11y-panel"
         class="hidden mt-7 border-t pt-7 [border-color:var(--a11y-border)]"
         data-accessibility-target="panel">
      <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-4">

        <fieldset class="m-0 border-0 p-0">
          <legend class="mb-3 text-[length:calc(13px*var(--a11y-scale))] font-bold uppercase tracking-[0.08em] text-[var(--a11y-muted)]">Colour &amp; contrast</legend>
          <div class="flex flex-wrap gap-2">
            <% [["Light", "light"], ["Dark", "dark"], ["High contrast", "high-contrast"], ["Calm", "calm"]].each_with_index do |(label, value), index| %>
              <button type="button"
                      class="inline-flex items-center gap-1.5 rounded-full border-2 px-4 py-2 font-semibold text-[var(--a11y-text)] text-[length:calc(15px*var(--a11y-scale))] [border-color:var(--a11y-border)] aria-pressed:bg-[var(--a11y-accent)] aria-pressed:text-[var(--a11y-accent-text)] aria-pressed:[border-color:var(--a11y-accent)]"
                      data-accessibility-target="control"
                      data-action="click->accessibility#choose"
                      data-accessibility-key-param="theme"
                      data-accessibility-value-param="<%= value %>"
                      aria-pressed="<%= index.zero? %>"><%= label %></button>
            <% end %>
          </div>
        </fieldset>

        <fieldset class="m-0 border-0 p-0">
          <legend class="mb-3 text-[length:calc(13px*var(--a11y-scale))] font-bold uppercase tracking-[0.08em] text-[var(--a11y-muted)]">Text size</legend>
          <div class="flex flex-wrap gap-2">
            <% [["A-", "small"], ["A", "medium"], ["A+", "large"], ["A++", "xlarge"]].each do |(label, value)| %>
              <button type="button"
                      class="inline-flex items-center gap-1.5 rounded-full border-2 px-4 py-2 font-semibold text-[var(--a11y-text)] text-[length:calc(15px*var(--a11y-scale))] [border-color:var(--a11y-border)] aria-pressed:bg-[var(--a11y-accent)] aria-pressed:text-[var(--a11y-accent-text)] aria-pressed:[border-color:var(--a11y-accent)]"
                      data-accessibility-target="control"
                      data-action="click->accessibility#choose"
                      data-accessibility-key-param="size"
                      data-accessibility-value-param="<%= value %>"
                      aria-pressed="<%= value == "medium" %>"><%= label %></button>
            <% end %>
          </div>
        </fieldset>

        <fieldset class="m-0 border-0 p-0">
          <legend class="mb-3 text-[length:calc(13px*var(--a11y-scale))] font-bold uppercase tracking-[0.08em] text-[var(--a11y-muted)]">Reading font</legend>
          <div class="flex flex-wrap gap-2">
            <% [["Standard", "standard"], ["Dyslexia-friendly", "dyslexia"]].each do |(label, value)| %>
              <button type="button"
                      class="inline-flex items-center gap-1.5 rounded-full border-2 px-4 py-2 font-semibold text-[var(--a11y-text)] text-[length:calc(15px*var(--a11y-scale))] [border-color:var(--a11y-border)] aria-pressed:bg-[var(--a11y-accent)] aria-pressed:text-[var(--a11y-accent-text)] aria-pressed:[border-color:var(--a11y-accent)]"
                      data-accessibility-target="control"
                      data-action="click->accessibility#choose"
                      data-accessibility-key-param="font"
                      data-accessibility-value-param="<%= value %>"
                      aria-pressed="<%= value == "standard" %>"><%= label %></button>
            <% end %>
          </div>
        </fieldset>

        <fieldset class="m-0 border-0 p-0">
          <legend class="mb-3 text-[length:calc(13px*var(--a11y-scale))] font-bold uppercase tracking-[0.08em] text-[var(--a11y-muted)]">More options</legend>
          <div class="flex flex-col gap-3">
            <% [
                 ["Roomier line spacing", "spacing", "relaxed"],
                 ["Wider letter spacing", "letters", "wide"],
                 ["Always underline links", "underline", "true"],
                 ["Reduce motion", "motion", "reduce"]
               ].each do |(label, key, value)| %>
              <button type="button"
                      class="group flex items-center justify-between gap-3 bg-transparent p-0 font-medium text-[var(--a11y-text)] text-[length:calc(16px*var(--a11y-scale))]"
                      data-accessibility-target="control"
                      data-action="click->accessibility#toggleSwitch"
                      data-accessibility-key-param="<%= key %>"
                      data-accessibility-value-param="<%= value %>"
                      aria-pressed="false">
                <span><%= label %></span>
                <span class="relative inline-block h-[22px] w-[38px] flex-shrink-0 rounded-full border-2 [border-color:var(--a11y-border)] group-aria-pressed:bg-[var(--a11y-accent)] group-aria-pressed:[border-color:var(--a11y-accent)]" aria-hidden="true">
                  <span class="absolute left-0.5 top-0.5 h-3.5 w-3.5 rounded-full bg-[var(--a11y-muted)] [transition-duration:var(--a11y-motion-duration)] transition-[left] group-aria-pressed:left-[18px] group-aria-pressed:bg-[var(--a11y-accent-text)]"></span>
                </span>
              </button>
            <% end %>
          </div>
        </fieldset>

      </div>

      <button type="button"
              class="mt-5 bg-transparent p-0 font-semibold text-[var(--a11y-muted)] text-[length:calc(14px*var(--a11y-scale))] underline"
              data-action="click->accessibility#reset">Reset to defaults</button>
    </div>

    <p class="mt-6 border-t pb-6 pt-6 text-center font-medium text-[var(--a11y-muted)] text-[length:calc(15px*var(--a11y-scale))] [border-color:var(--a11y-border)]">
      &copy; <%= Time.current.year %> Autistic Led. All rights reserved.
      &middot;
      Site made by <%= link_to "Ellis Development", "https://ebrookes.dev", target: "_blank", rel: "noopener noreferrer", class: "underline" %>
    </p>

  </div>
</footer>
